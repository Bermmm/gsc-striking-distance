+def comparison_pages(tables, label):
+    rows = tables.get("pages.csv")
+    if rows is None:
+        sys.exit(f"{label} export is missing Pages.csv. Use a standard Search results export.")
+    required = {"Top pages", "Clicks", "Impressions", "Position"}
+    if rows and not required.issubset(rows[0]):
+        sys.exit(f"{label} Pages.csv needs the columns: {', '.join(sorted(required))}.")
+    pages = {}
+    for row in normalize(rows, "Top pages"):
+        pages[row["key"]] = {
+            "clicks": row["clicks"],
+            "impressions": row["impressions"],
+            "ctr_pct": 100 * row["ctr"] if row["impressions"] else None,
+            "position": row["position"] if row["impressions"] and row["position"] > 0 else None,
+            "key": row["key"],
+        }
+    return pages
+
+
+def period_dates(tables):
+    values = [r.get("Date") for r in tables.get("chart.csv", [])]
+    try:
+        days = [date.fromisoformat(value) for value in values]
+    except (ValueError, TypeError):
+        return None
+    return (min(days), max(days)) if days else None
+
+
+def compare_exports(before, after, args):
+    earlier = comparison_pages(before, "Before")
+    later = comparison_pages(after, "After")
+    if args.page:
+        keys = [args.page]
+        if args.page not in earlier and args.page not in later:
+            sys.exit("Page missing from both exports. Copy the full URL from Pages.csv.")
+    else:
+        ranked = (row for row in earlier.values() if row["position"] is not None)
+        opportunities = striking_distance(ranked, args.min_pos, args.max_pos,
+                                          args.min_impr, args.target)
+        keys = [row["key"] for row in opportunities]
+
+    periods = [period_dates(before), period_dates(after)]
+    report = ["# Before-and-after page comparison", ""]
+    for label, path, dates in zip(("Before", "After"), (args.before, args.export), periods):
+        span = f"{dates[0]} to {dates[1]}" if dates else "dates unavailable"
+        report.append(f"- {label}: {Path(path).name} ({span})")
+    report.append("")
+    if all(periods):
+        (start, end), (next_start, next_end) = periods
+        if next_start <= end:
+            report += ["The periods overlap or are out of order. "
+                       "Use separate, chronological windows for follow-up.", ""]
+        if end - start != next_end - next_start:
+            report += ["The windows have different lengths. Clicks and impressions are raw totals.", ""]
+
+    if not args.page:
+        report += [f"Tracking {len(keys)} pages in the earlier striking-distance ranking. "
+                   f"Showing up to {args.top} in the original priority order.", ""]
+    report += ["Values show before → after (change). CTR change is in percentage points. "
+               "A negative position change means the page moved up. "
+               "A dash means the metric is unavailable.", ""]
+
+    metrics = (("clicks", "Clicks", ",d"), ("impressions", "Impressions", ",d"),
+               ("ctr_pct", "CTR", ".2f"), ("position", "Avg. position", ".1f"))
+    output_rows, table = [], []
+    for key in keys:
+        row = {"page": key}
+        cells = [key.replace("|", r"\|")]
+        for field, _, fmt in metrics:
+            old = earlier.get(key, {}).get(field)
+            new = later.get(key, {}).get(field)
+            row[f"{field}_before"] = old
+            row[f"{field}_after"] = new
+            delta = new - old if old is not None and new is not None else None
+            row[f"{field}_change"] = delta
+            suffix = "%" if field == "ctr_pct" else ""
+            pair = " → ".join("—" if v is None else format(v, fmt) + suffix for v in (old, new))
+            if delta is not None:
+                unit = " pp" if field == "ctr_pct" else ""
+                pair += f" ({delta:+{fmt}}{unit})"
+            cells.append(pair)
+        output_rows.append(row)
+        table.append(cells)
+
+    if table:
+        report.append(md_table(["Page"] + [name for _, name, _ in metrics], table[:args.top]))
+    else:
+        report.append("No pages met the earlier striking-distance filters.")
+    if args.csv:
+        directory = Path(args.csv)
+        directory.mkdir(parents=True, exist_ok=True)
+        fields = ["page"] + [f"{field}_{part}" for field, _, _ in metrics
+                             for part in ("before", "after", "change")]
+        write_csv(directory / "page-comparison.csv", output_rows, fields)
+    return "\n".join(report) + "\n"
+
