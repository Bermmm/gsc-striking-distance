+import csv
+import subprocess
+import sys
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+
+SCRIPT = Path(__file__).with_name("gsc_striking_distance.py").resolve()
+PAGE = "https://example.com/guide"
+
+
+class PageComparisonTests(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.root = Path(temp.name)
+        self.before = self.root / "before"
+        self.before.mkdir()
+        (self.before / "Pages.csv").write_text(
+            "Top pages,Clicks,Impressions,Position\n"
+            f"{PAGE},1,100,9.6\n{PAGE}-missing,0,30,12\n", encoding="utf-8")
+        (self.before / "Chart.csv").write_text(
+            "Date\n2026-10-01\n2026-10-02\n", encoding="utf-8")
+        self.after = self.root / "after.zip"
+        with zipfile.ZipFile(self.after, "w") as archive:
+            archive.writestr("Pages.csv", "Top pages,Clicks,Impressions,Position\n"
+                             f"{PAGE},8,200,3.1\n{PAGE}-new,0,0,0\n")
+            archive.writestr("Chart.csv", "Date\n2026-10-04\n2026-10-03\n")
+
+    def run_cli(self, *options):
+        return subprocess.run([sys.executable, str(SCRIPT), str(self.after), *options],
+                              cwd=self.root, capture_output=True, text=True)
+
+    def test_earlier_opportunities_survive_rank_change_and_mark_missing_rows(self):
+        result = self.run_cli("--before", str(self.before), "--top", "1", "--csv", "out")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        report = (self.root / "page-comparison.md").read_text(encoding="utf-8")
+        self.assertIn("1 → 8 (+7)", report)
+        self.assertIn("1.00% → 4.00% (+3.00 pp)", report)
+        self.assertIn("9.6 → 3.1 (-6.5)", report)
+        self.assertIn("2026-10-03 to 2026-10-04", report)
+        self.assertNotIn(PAGE + "-missing", report)
+        with (self.root / "out/page-comparison.csv").open(encoding="utf-8") as data:
+            kept, missing = list(csv.DictReader(data))
+        self.assertEqual(kept["clicks_change"], "7")
+        self.assertEqual(missing["page"], PAGE + "-missing")
+        self.assertEqual(missing["clicks_before"], "0")
+        self.assertEqual(missing["clicks_after"], "")
+        self.assertEqual(missing["clicks_change"], "")
+
+    def test_exact_url_can_be_new_with_zero_impressions(self):
+        result = self.run_cli("--before", str(self.before), "--page", PAGE + "-new")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        report = (self.root / "page-comparison.md").read_text(encoding="utf-8")
+        self.assertIn("| — → 0 | — → 0 | — → — | — → — |", report)
+
+    def test_unknown_page_returns_error(self):
+        result = self.run_cli("--before", str(self.before), "--page", PAGE + "-typo")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("missing from both exports", result.stderr)
+        self.assertFalse((self.root / "page-comparison.md").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
